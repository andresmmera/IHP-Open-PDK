<Library name="IHP SG13G2 Basic Components">
     <Component name="MIM Capacitor" schematic_id = "Cmim">
        <Description>
            SG13G2 MIM capacitor
        </Description>
        <Netlists>
                <NgspiceNetlist value = 'Xcap_cmim{PartCounter} {nets} cap_cmim w={w} l={l} m=1'>
                    <Include value=".LIB {PDK_ROOT}/ihp-sg13g2/libs.tech/ngspice/models/cornerCAP.lib cap_typ">
                    </Include>
                </NgspiceNetlist>
        </Netlists>
        <Symbols>
            <Symbol id="Standard" type="external"> <!-- Generic symbol from the "Lumped Components" library -->
               <File>{QUCS_S_COMPONENTS_LIBRARY}/Lumped_Component_Symbols/Capacitor.sym</File>
            </Symbol>
        </Symbols>
        <Parameters>
            <Parameter name="w" unit="um" default_value="70" show="true">
                <Description>Width</Description>
            </Parameter>
            <Parameter name="l" unit="um" default_value="70" show="true">
                <Description>Length</Description>
            </Parameter>
        </Parameters>
    </Component>

